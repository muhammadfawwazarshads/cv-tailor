# Copy to .env and adjust. All variables are optional in development.

# PostgreSQL connection string. Leave empty to use the embedded PGlite database in DATA_DIR.
DATABASE_URL=
# postgres://cvtailor:cvtailor@localhost:5432/cvtailor

# Folder for the embedded database and the development secret.
DATA_DIR=./data

PORT=3000

# Required in production (min. 32 characters). Signs login sessions and encrypts stored API keys.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everyone out and makes stored API keys unreadable (re-enter them in the admin panel).
APP_SECRET=

# Set to false to close public sign-up after the first (admin) account exists.
ALLOW_REGISTRATION=true

# Successful AI requests allowed per user per 24 hours (0 = unlimited). Admins are not limited.
DAILY_AI_LIMIT=50

# Timeout for a single AI request before falling back to the next provider (ms).
LLM_TIMEOUT_MS=120000

# Enables the "Mock" provider type for demos and tests without API keys.
ENABLE_MOCK_LLM=false

MAX_UPLOAD_MB=10
