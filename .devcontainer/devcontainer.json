{
  "name": "Jahit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2 },
  "containerEnv": {
    "PORT": "3000",
    "ENABLE_MOCK_LLM": "true"
  },
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "nohup bash -c 'npm start > /tmp/cv-tailor.log 2>&1 &'",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Jahit", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
